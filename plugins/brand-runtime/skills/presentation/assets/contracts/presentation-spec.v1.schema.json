{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartscaile.com/brand-runtime/presentation-spec.v1.schema.json",
  "title": "Smartscaile Presentation Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "briefStatus", "qualityPolicy", "slides"],
  "properties": {
    "schema": { "const": "smartscaile.presentation-spec.v1" },
    "title": { "type": "string", "minLength": 1 },
    "briefStatus": { "enum": ["draft", "ready"] },
    "qualityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConsecutiveFamily", "maxEyebrowRatio"],
      "properties": {
        "maxConsecutiveFamily": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxEyebrowRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "job", "family"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "job": { "enum": ["context", "tension", "proof", "mechanism", "comparison", "decision", "transition", "close"] },
          "family": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
